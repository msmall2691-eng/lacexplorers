# =============================================================================
# Arrowhead Explorers — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in whichever option you want to use
# for the Interest List form. You only need ONE of the options below.
#
#   cp .env.example .env.local
#
# If you leave everything blank, the form still "works" in a demo mode: it shows
# the confirmation message but does NOT save or send anything. Connect one of the
# options below before you start sharing the site publicly so you actually receive
# inquiries. See the README ("Connecting the Interest form") for step-by-step help.
# -----------------------------------------------------------------------------

# ---- Where should inquiry notifications be sent? ----------------------------
# Your email address. Used by the Resend option below to email you each inquiry.
INTEREST_NOTIFY_EMAIL="lacexplorers@gmail.com"

# =============================================================================
# OPTION A — Resend (recommended: emails each inquiry straight to your inbox)
# Sign up free at https://resend.com, verify a sending domain (or use their
# onboarding sender), then paste your API key here.
# =============================================================================
RESEND_API_KEY=""
# The "from" address Resend sends as. Must be on a domain you've verified in
# Resend. During testing you can use "onboarding@resend.dev".
RESEND_FROM_EMAIL="Arrowhead Explorers <onboarding@resend.dev>"

# =============================================================================
# OPTION B — Supabase (stores every inquiry in a database table you can browse)
# Create a free project at https://supabase.com. See the README for the SQL to
# create the `interest_inquiries` table. Then paste your project URL and the
# SERVICE ROLE key (server-side only — never expose the service role key to the
# browser or commit it to git).
# =============================================================================
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# OPTION C — Formspree (no backend; simplest for a non-technical setup)
# Create a free form at https://formspree.io and paste your endpoint URL below,
# e.g. https://formspree.io/f/abcdwxyz
# =============================================================================
NEXT_PUBLIC_FORMSPREE_ENDPOINT=""

# =============================================================================
# Site URL — used for absolute links, sitemap, and social sharing metadata.
# Set this to your live domain once deployed (e.g. https://arrowheadexplorers.com).
# =============================================================================
NEXT_PUBLIC_SITE_URL="https://arrowheadexplorers.com"
